events {
}

http {
    server_names_hash_bucket_size 64;
    server {
        listen 443 ssl default_server;

        ssl_certificate /app/cert/cert.crt;
        ssl_certificate_key /app/cert/key.key;

        return 444;
    }

    server {
        listen 443 ssl;
        server_name ${ADMIN_DOMAIN};

        ssl_certificate /app/cert/cert.crt;
        ssl_certificate_key /app/cert/key.key;

        location / {
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Range $http_range;
            proxy_set_header If-Range $http_if_range;

            proxy_redirect off;
            proxy_pass http://3xui:2053;
        }
    }

    server {
        listen 443 ssl;
        server_name ${SUBSCRIPTION_DOMAIN};

        ssl_certificate /app/cert/cert.crt;
        ssl_certificate_key /app/cert/key.key;

        # Exact root only: https://SUBSCRIPTION_DOMAIN/ -> static borscht page.
        # alias (not root) is used to avoid an internal redirect into "location /".
        location = / {
            root /usr/share/nginx/html;
            rewrite ^/$ /borscht.html break;
            charset utf-8;
        }

        # Everything with a path (/sub/..., /<username>, panel assets, etc.) goes to 3x-ui.
        location / {
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Range $http_range;
            proxy_set_header If-Range $http_if_range;

            proxy_redirect off;
            proxy_pass http://3xui:2096;
        }
    }
}
